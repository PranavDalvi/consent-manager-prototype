generator client {
  //if you use js instead of ts use prisma-client-js instead prisma-client
  provider   = "prisma-client-js"
  output     = "../src/generated/"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consents  Consent[]
  auditLogs AuditLog[]

  @@index([isActive])
}

model Consent {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId        String
  purpose       String
  status        ConsentStatus
  policyVersion String
  createdAt     DateTime      @default(now())

  @@unique([tenantId, userId, purpose])
  @@index([tenantId])
  @@index([userId])
  @@index([purpose])
  @@index([userId, purpose])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String
  action    String
  purpose   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}
