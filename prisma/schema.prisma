generator client {
//if you use js instead of ts use prisma-client-js instead prisma-client
  provider   = "prisma-client-js"
  output     = "../src/generated/"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
}

enum TenantUserRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  consents            Consent[]
  policies            Policy[]
  auditLogs           AuditLog[]
  apiKeys             ApiKey[]
  webhooks            Webhook[]
  internalEvents      InternalEvent[]
  outboxEvents        OutboxEvent[]
  webhookDeliveries   WebhookDelivery[]
  users               TenantUser[]
  invitations         Invitation[]
  touchpoints         Touchpoint[]

  @@index([isActive])
  @@index([status])
}

model TenantUser {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  firstName    String?
  lastName     String?
  role         TenantUserRole @default(OWNER)
  isActive     Boolean        @default(true)
  failedLogins Int            @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  sessions           Session[]
  passwordResetTokens PasswordResetToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model Session {
  id               String     @id @default(cuid())
  userId           String
  user             TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String     @unique
  device           String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime   @default(now())
  lastUsedAt       DateTime   @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedBy       String?

  @@index([userId])
  @@index([refreshTokenHash])
}

model Invitation {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String
  role       TenantUserRole @default(DEVELOPER)
  tokenHash  String         @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdBy  String
  createdAt  DateTime       @default(now())

  @@index([tenantId])
  @@index([email])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String     @id @default(cuid())
  userId    String
  user      TenantUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String     @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([tokenHash])
}


enum CircuitBreakerState {
  CLOSED
  OPEN
  HALF_OPEN
}

model OutboxEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventType   String
  aggregateId String?
  payload     Json
  status      String   @default("PENDING")
  retryCount  Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([tenantId])
  @@index([status])
  @@index([status, createdAt])
}

model WebhookCircuitBreaker {
  id                  String              @id @default(cuid())
  webhookId           String              @unique
  webhook             Webhook             @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  state               CircuitBreakerState @default(CLOSED)
  consecutiveFailures Int                 @default(0)
  openedAt            DateTime?
  lastTestedAt        DateTime?
  updatedAt           DateTime            @updatedAt

  @@index([webhookId])
  @@index([state])
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  webhookId       String
  webhook         Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  eventId         String
  attempt         Int      @default(1)
  status          String   // SUCCESS | FAILED
  httpStatus      Int?
  responseBody    String?
  responseHeaders Json?
  duration        Int      // in ms
  errorMessage    String?
  createdAt       DateTime @default(now())

  retryHistories WebhookRetryHistory[]

  @@index([tenantId])
  @@index([webhookId])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}

model WebhookRetryHistory {
  id          String          @id @default(cuid())
  deliveryId  String
  delivery    WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attempt     Int
  reason      String?
  scheduledAt DateTime
  executedAt  DateTime?
  result      String?         // SUCCESS | FAILED | PENDING
  createdAt   DateTime        @default(now())

  @@index([deliveryId])
}

model ReplayHistory {
  id                String   @id @default(cuid())
  targetType        String   // WEBHOOK | INTERNAL_EVENT | DLQ_JOB
  targetId          String
  originalJobId     String?
  newJobId          String?
  reason            String?
  result            String   // SUCCESS | FAILED
  operatorId        String?
  replayCount       Int      @default(1)
  maxReplayAttempts Int      @default(5)
  replayedAt        DateTime @default(now())

  @@index([targetType, targetId])
  @@index([replayedAt])
}

model CleanupExecution {
  id             String   @id @default(cuid())
  jobName        String
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  status         String   // SUCCESS | FAILED | RUNNING
  itemsProcessed Int      @default(0)
  itemsDeleted   Int      @default(0)
  durationMs     Int?
  errorMessage   String?

  @@index([jobName])
  @@index([startedAt])
}

model Policy {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  title     String
  purpose   String
  version   Int
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consents            Consent[]
  touchpointPolicies TouchpointPolicy[]

  @@index([tenantId])
  @@index([tenantId, purpose])
  @@index([tenantId, purpose, version])
  @@unique([tenantId, purpose, version])
}

model Touchpoint {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  policies    TouchpointPolicy[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model TouchpointPolicy {
  id           String     @id @default(cuid())
  touchpointId String
  touchpoint   Touchpoint @relation(fields: [touchpointId], references: [id], onDelete: Cascade)
  policyId     String
  policy       Policy     @relation(fields: [policyId], references: [id], onDelete: Restrict)
  isRequired   Boolean    @default(true)
  displayOrder Int        @default(0)
  customLabel  String?
  createdAt    DateTime   @default(now())

  @@unique([touchpointId, policyId])
  @@index([touchpointId])
  @@index([policyId])
}

model Consent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId     String
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Restrict)
  purpose    String
  status     ConsentStatus
  policyVersion Int
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([policyId])
  @@index([purpose])
  @@index([userId, purpose])
  @@unique([tenantId, userId, purpose])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId     String
  action     String
  purpose    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyPrefix])
}

model Webhook {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  circuitBreaker WebhookCircuitBreaker?
  deliveries     WebhookDelivery[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model InternalEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type        String
  payload     Json
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dispatchedAt DateTime?
  processedAt DateTime?

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
}

model SuperAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  role         String    @default("SUPER_ADMIN")
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

