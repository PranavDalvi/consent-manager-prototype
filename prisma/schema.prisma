generator client {
//if you use js instead of ts use prisma-client-js instead prisma-client
  provider   = "prisma-client-js"
  output     = "../src/generated/"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

model Consent {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  purpose       String
  status        ConsentStatus
  policyVersion String
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([purpose])
  @@index([userId, purpose])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  action     String
  purpose    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
}