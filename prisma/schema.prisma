generator client {
//if you use js instead of ts use prisma-client-js instead prisma-client
  provider   = "prisma-client-js"
  output     = "../src/generated/"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consents  Consent[]
  policies  Policy[]
  auditLogs AuditLog[]
  apiKeys   ApiKey[]
  webhooks  Webhook[]
  internalEvents InternalEvent[]

  @@index([isActive])
}

model Policy {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  title     String
  purpose   String
  version   Int
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consents  Consent[]

  @@index([tenantId])
  @@index([tenantId, purpose])
  @@index([tenantId, purpose, version])
  @@unique([tenantId, purpose, version])
}

model Consent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId     String
  policyId   String
  policy     Policy   @relation(fields: [policyId], references: [id], onDelete: Restrict)
  purpose    String
  status     ConsentStatus
  policyVersion Int
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([policyId])
  @@index([purpose])
  @@index([userId, purpose])
  @@unique([tenantId, userId, purpose])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId     String
  action     String
  purpose    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyPrefix])
}

model Webhook {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model InternalEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type        String
  payload     Json
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dispatchedAt DateTime?
  processedAt DateTime?

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
}

model SuperAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  role         String    @default("SUPER_ADMIN")
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

